<?xml version="1.0"?>
<!-- Gazebo Harmonic diff-drive rover: wheels touch ground, body does not.
     Model origin Z = wheel contact plane. -->
<sdf version="1.9">
  <model name="lunar_rover">
    <link name="base_link">
      <!-- Chassis center above wheel axles (radius 0.18 + half-height 0.125) -->
      <pose>0 0 0.305 0 0 0</pose>
      <velocity_decay>
        <linear>0.35</linear>
        <angular>0.25</angular>
      </velocity_decay>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.35</ixx><iyy>0.55</iyy><izz>0.65</izz>
        </inertia>
      </inertial>
      <!-- Visual only on body — no chassis collision (stops scraping / bouncing) -->
      <visual name="body_vis">
        <geometry><box><size>0.9 0.65 0.22</size></box></geometry>
        <material>
          <ambient>0.7 0.7 0.75 1</ambient>
          <diffuse>0.75 0.75 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0 0 1.57079632679 0 0</pose>
      <velocity_decay>
        <linear>0.2</linear>
        <angular>0.1</angular>
      </velocity_decay>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><sphere><radius>0.18</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>500</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <pose>0 0.42 -0.125 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.4</damping><friction>0.05</friction></dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="right_wheel">
      <pose>0 0 0 1.57079632679 0 0</pose>
      <velocity_decay>
        <linear>0.2</linear>
        <angular>0.1</angular>
      </velocity_decay>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia>
      </inertial>
      <collision name="col">
        <geometry><sphere><radius>0.18</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>500</kd>
              <max_vel>0.05</max_vel>
              <min_depth>0.002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.18</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <pose>0 -0.42 -0.125 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.4</damping><friction>0.05</friction></dynamics>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <!-- Casters stop pitch rocking on uneven heightmap -->
    <link name="front_caster">
      <pose>0 0 0 0 0 0</pose>
      <inertial><mass>0.15</mass></inertial>
      <collision name="col">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          <contact>
            <ode><kp>50000</kp><kd>200</kd><max_vel>0.05</max_vel></ode>
          </contact>
        </surface>
      </collision>
      <visual name="vis">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
    </link>

    <joint name="front_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>front_caster</child>
      <pose>0.38 0 -0.225 0 0 0</pose>
    </joint>

    <link name="rear_caster">
      <pose>0 0 0 0 0 0</pose>
      <inertial><mass>0.15</mass></inertial>
      <collision name="col">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          <contact>
            <ode><kp>50000</kp><kd>200</kd><max_vel>0.05</max_vel></ode>
          </contact>
        </surface>
      </collision>
      <visual name="vis">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>
    </link>

    <joint name="rear_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_caster</child>
      <pose>-0.38 0 -0.225 0 0 0</pose>
    </joint>

    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.84</wheel_separation>
      <wheel_radius>0.18</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
      <min_angular_velocity>-1.2</min_angular_velocity>
      <max_linear_acceleration>0.35</max_linear_acceleration>
      <max_angular_acceleration>0.8</max_angular_acceleration>
    </plugin>

  </model>
</sdf>
